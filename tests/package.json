{
  "name": "labelling-platform-frontend-tests",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "seed:test-users": "node scripts/seedTestUsers.js",
    "clean:test-users": "node scripts/seedTestUsers.js --clean --with-existing-admin",
    "test:e2e": "wdio run wdio/wdio.conf.js",
    "test:e2e:ci": "wdio run wdio/wdio.conf.ci.js",
    "test:unit": "jest --config jest.config.js",
    "test:unit:watch": "jest --config jest.config.js --watch",
    "test:all": "npm run test:unit && npm run test:e2e",
    "allure:generate:e2e": "allure generate reports/allure-results --clean -o reports/allure-report || echo 'No E2E results found'",
    "allure:generate:unit": "allure generate unit/reports/allure-results --clean -o unit/reports/allure-report || echo 'No unit results found'",
    "allure:open": "allure open reports/allure-report --port 8765 --host 0.0.0.0",
    "allure:serve": "allure serve reports/allure-results --port 8765 --host 0.0.0.0",
    "allure:report": "npm run allure:generate:e2e && echo '\\n=== Allure Report ready! ===\\nOpen http://localhost:8765 in your browser\\n=== Press Ctrl+C to stop the server ===\\n' && python3 -m http.server 8765 --directory reports/allure-report"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.2",
    "@babel/register": "^7.28.6",
    "@faker-js/faker": "^8.4.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@wdio/allure-reporter": "^9.0.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/globals": "^9.0.0",
    "@wdio/junit-reporter": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "allure-commandline": "^2.30.0",
    "dotenv": "^16.4.0",
    "expect-webdriverio": "^5.6.5",
    "jest": "^29.7.0",
    "jest-allure2-reporter": "^1.2.0",
    "jest-environment-jsdom": "^29.7.0"
  }
}